[{"word": "manufacturing", "phonetic": "/\u02ccm\u00e6nj\u028a\u02c8f\u00e6kt\u0361\u0283\u0259\u0279\u026a\u014b/", "phonetics": [{"text": "/\u02ccm\u00e6nj\u028a\u02c8f\u00e6kt\u0361\u0283\u0259\u0279\u026a\u014b/", "audio": ""}, {"text": "/\u02ccm\u00e6nj\u0259\u02c8f\u00e6kt\u0361\u0283\u0259\u0279\u026a\u014b/", "audio": ""}], "meanings": [{"partOfSpeech": "verb", "definitions": [{"definition": "To make things, usually on a large scale, with tools and either physical labor or machinery.", "synonyms": [], "antonyms": []}, {"definition": "To work (raw or partly wrought materials) into suitable forms for use.", "synonyms": [], "antonyms": [], "example": "to manufacture wool into blankets"}, {"definition": "To fabricate; to create false evidence to support a point.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": []}, {"partOfSpeech": "noun", "definitions": [{"definition": "The transformation of raw materials into finished products, usually on a large scale.", "synonyms": [], "antonyms": []}, {"definition": "The industry in which such products are made.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": []}, {"partOfSpeech": "adjective", "definitions": [{"definition": "Used in manufacturing.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": []}], "license": {"name": "CC BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}, "sourceUrls": ["https://en.wiktionary.org/wiki/manufacture", "https://en.wiktionary.org/wiki/manufacturing"]}]