[{"word": "decided", "phonetic": "/d\u026a\u02c8sa\u026ad\u0259d/", "phonetics": [{"text": "/d\u026a\u02c8sa\u026ad\u0259d/", "audio": ""}, {"audio": "https://api.dictionaryapi.dev/media/pronunciations/en/decided-us.mp3", "sourceUrl": "https://commons.wikimedia.org/w/index.php?curid=1231874", "license": {"name": "BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}}], "meanings": [{"partOfSpeech": "verb", "definitions": [{"definition": "To resolve (a contest, problem, dispute, etc.); to choose, determine, or settle", "synonyms": [], "antonyms": [], "example": "Her last-minute goal decided the game."}, {"definition": "To make a judgment, especially after deliberation", "synonyms": [], "antonyms": [], "example": "I have decided that it is healthier to walk to work."}, {"definition": "To cause someone to come to a decision", "synonyms": [], "antonyms": []}, {"definition": "To cut off; to separate", "synonyms": [], "antonyms": []}], "synonyms": ["choose", "determine", "make up one's mind", "pick"], "antonyms": []}, {"partOfSpeech": "adjective", "definitions": [{"definition": "Determined; resolute", "synonyms": [], "antonyms": [], "example": "A woman of decided opinions"}, {"definition": "Clear; unmistakable", "synonyms": [], "antonyms": [], "example": "There was a decided ugliness to the patch of waste ground."}], "synonyms": [], "antonyms": ["undecided"]}], "license": {"name": "CC BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}, "sourceUrls": ["https://en.wiktionary.org/wiki/decide", "https://en.wiktionary.org/wiki/decided"]}]