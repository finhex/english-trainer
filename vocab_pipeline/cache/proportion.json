[{"word": "proportion", "phonetic": "/p\u0279\u0259\u02c8p\u0254\u02d0\u0283\u0259n/", "phonetics": [{"text": "/p\u0279\u0259\u02c8p\u0254\u02d0\u0283\u0259n/", "audio": ""}, {"text": "/p\u0279\u0259\u02c8p\u0254\u0279\u0283\u0259n/", "audio": "https://api.dictionaryapi.dev/media/pronunciations/en/proportion-us.mp3", "sourceUrl": "https://commons.wikimedia.org/w/index.php?curid=1684698", "license": {"name": "BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}}], "meanings": [{"partOfSpeech": "noun", "definitions": [{"definition": "A quantity of something that is part of the whole amount or number.", "synonyms": [], "antonyms": []}, {"definition": "Harmonious relation of parts to each other or to the whole.", "synonyms": [], "antonyms": []}, {"definition": "Proper or equal share.", "synonyms": [], "antonyms": []}, {"definition": "The relation of one part to another or to the whole with respect to magnitude, quantity, or degree.", "synonyms": [], "antonyms": [], "example": "the proportion of the parts of a building, or of the body"}, {"definition": "A statement of equality between two ratios.", "synonyms": [], "antonyms": []}, {"definition": "The \"rule of three\", in which three terms are given to find a fourth.", "synonyms": [], "antonyms": []}, {"definition": "(chiefly in the plural) Size.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": []}, {"partOfSpeech": "verb", "definitions": [{"definition": "To divide into proper shares; to apportion.", "synonyms": [], "antonyms": []}, {"definition": "To form symmetrically.", "synonyms": [], "antonyms": []}, {"definition": "To set or render in proportion.", "synonyms": [], "antonyms": []}, {"definition": "To correspond to.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": []}], "license": {"name": "CC BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}, "sourceUrls": ["https://en.wiktionary.org/wiki/proportion"]}]