[{"word": "regarded", "phonetic": "/\u0279\u026a\u02c8\u0261\u0251\u02d0d\u026ad/", "phonetics": [{"text": "/\u0279\u026a\u02c8\u0261\u0251\u02d0d\u026ad/", "audio": ""}, {"text": "/\u0279\u026a\u02c8\u0261\u0251\u0279d\u026ad/", "audio": "https://api.dictionaryapi.dev/media/pronunciations/en/regarded-us.mp3", "sourceUrl": "https://commons.wikimedia.org/w/index.php?curid=1446748", "license": {"name": "BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}}], "meanings": [{"partOfSpeech": "verb", "definitions": [{"definition": "To look at; to observe.", "synonyms": [], "antonyms": [], "example": "She regarded us warily."}, {"definition": "To consider, look upon (something) in a given way etc.", "synonyms": [], "antonyms": [], "example": "He regards honesty as a duty."}, {"definition": "To take notice of, pay attention to.", "synonyms": [], "antonyms": []}, {"definition": "To face toward.", "synonyms": [], "antonyms": []}, {"definition": "To have to do with, to concern.", "synonyms": [], "antonyms": [], "example": "That argument does not regard the question."}, {"definition": "To set store by (something), to hold (someone) in esteem; to consider to have value, to respect.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": ["ignore", "neglect"]}], "license": {"name": "CC BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}, "sourceUrls": ["https://en.wiktionary.org/wiki/regard", "https://en.wiktionary.org/wiki/regarded"]}]