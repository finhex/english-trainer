[{"word": "becoming", "phonetic": "/b\u026a\u02c8k\u028am\u026a\u014b\u0261/", "phonetics": [{"text": "/b\u026a\u02c8k\u028am\u026a\u014b\u0261/", "audio": ""}, {"text": "/b\u0259\u02c8k\u028cm\u026a\u014b/", "audio": "https://api.dictionaryapi.dev/media/pronunciations/en/becoming-us.mp3", "sourceUrl": "https://commons.wikimedia.org/w/index.php?curid=1676700", "license": {"name": "BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}}], "meanings": [{"partOfSpeech": "verb", "definitions": [{"definition": "To arrive, come (to a place).", "synonyms": [], "antonyms": []}, {"definition": "To come about; happen; come into being; arise.", "synonyms": [], "antonyms": [], "example": "It hath becomen so that many a man had to sterve."}, {"definition": "Begin to be; turn into.", "synonyms": ["get", "go", "turn"], "antonyms": [], "example": "She became a doctor when she was 25."}, {"definition": "To be proper for; to beseem.", "synonyms": [], "antonyms": []}, {"definition": "Of an adornment, piece of clothing etc.: to look attractive on (someone).", "synonyms": [], "antonyms": [], "example": "That dress really becomes you."}], "synonyms": ["befit", "suit", "get", "go", "turn"], "antonyms": []}, {"partOfSpeech": "noun", "definitions": [{"definition": "The act or process by which something becomes.", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": []}, {"partOfSpeech": "adjective", "definitions": [{"definition": "Pleasingly suitable; fit; congruous; beautiful", "synonyms": [], "antonyms": []}, {"definition": "Decent, respectable", "synonyms": [], "antonyms": []}], "synonyms": [], "antonyms": ["unbecoming"]}], "license": {"name": "CC BY-SA 3.0", "url": "https://creativecommons.org/licenses/by-sa/3.0"}, "sourceUrls": ["https://en.wiktionary.org/wiki/become", "https://en.wiktionary.org/wiki/becoming"]}]